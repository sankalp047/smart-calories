import Foundation

/// Backend configuration. Copy this file to `Secrets.swift` and fill in your own
/// endpoint — `Secrets.swift` is gitignored so the URL never enters version control.
///
///     cp SmartCalories/Services/Secrets.swift.example \
///        SmartCalories/Services/Secrets.swift
///
/// The backend is a thin proxy: it structures OCR'd label text, exchanges Apple
/// identity tokens for a session, and ingests heart-rate samples. Any host
/// implementing those routes works.
enum Secrets {
    /// Base URL, no trailing slash. e.g. "https://example.workers.dev"
    static let backendBaseURL = "https://your-backend.example.com"
}
